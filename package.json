{
  "name": "vue-lottery-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lab 4-5 - lottery app on Vue 3 (Composition API + TypeScript, vue-router, Pinia, JWT)",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\"",
    "postbuild": "node scripts/spa-fallback.mjs",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@vee-validate/yup": "^4.15.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "pinia": "^3.0.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "gh-pages": "^6.3.0",
    "prettier": "^3.3.0",
    "sass": "^1.95.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.0"
  }
}
